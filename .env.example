# Reference for a private deployment; export values or use a service EnvironmentFile.
TRADGARDSRYTMEN_SECRET_KEY=replace-with-a-generated-secret
TRADGARDSRYTMEN_DEBUG=0
TRADGARDSRYTMEN_ALLOWED_HOSTS=localhost,127.0.0.1,garden.example.com
TRADGARDSRYTMEN_CSRF_TRUSTED_ORIGINS=https://garden.example.com
TRADGARDSRYTMEN_DB_PATH=/var/lib/tradgardsrytmen/db.sqlite3
TRADGARDSRYTMEN_DATA_DIR=/var/lib/tradgardsrytmen
TRADGARDSRYTMEN_GARDEN_ID=replace-after-explicit-legacy-assignment
TRADGARDSRYTMEN_OIDC_ISSUER=
TRADGARDSRYTMEN_OIDC_AUDIENCE=
TRADGARDSRYTMEN_OIDC_JWKS_URL=
TRADGARDSRYTMEN_OIDC_REQUIRED_SCOPE=garden:access
TRADGARDSRYTMEN_OIDC_AUTO_PROVISION=0
TRADGARDSRYTMEN_OPENAI_MODEL=gpt-5.6-luna
TRADGARDSRYTMEN_VAPID_SUBJECT=mailto:garden@example.com
OPENAI_API_KEY=

# P3: opt-in only after a reviewed cutover. SQLite remains the default.
TRADGARDSRYTMEN_DB_ENGINE=sqlite
TRADGARDSRYTMEN_DURABLE_JOBS=0
# PostgreSQL requires PGDATABASE, PGUSER, PGHOST; optional PGPASSWORD/PGPORT.
# PGSSLMODE defaults to verify-full. Use disable only for isolated local tests.
# PGDATABASE=tradgardsrytmen
# PGUSER=tradgardsrytmen
# PGHOST=your-postgres-host
# PGPORT=5432
# PGSSLMODE=verify-full
