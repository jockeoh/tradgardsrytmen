[Unit]
Description=Trädgårdsrytmen bounded durable worker
After=network-online.target

[Service]
Type=oneshot
User=tradgardsrytmen
Group=tradgardsrytmen
WorkingDirectory=/opt/tradgardsrytmen/app
EnvironmentFile=/etc/tradgardsrytmen/tradgardsrytmen.env
ExecStart=/opt/tradgardsrytmen/venv/bin/python manage.py run_jobs --garden ${TRADGARDSRYTMEN_GARDEN_ID} --limit 1 --allow-external
TimeoutStartSec=180
TimeoutStopSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradgardsrytmen
